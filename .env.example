# 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채우세요.
GEMINI_API_KEY=AIza여기에_발급받은_키

# gemini = 실제 모델 / fake = 키 없이 흐름만 테스트
LLM_PROVIDER=gemini

# 서아의 대화용 모델과 판정·요약용 모델 (쉼표로 여러 개 = 앞 모델이 바쁘면 다음 모델로)
# CHAT_MODELS / JUDGE_MODELS가 없으면 CHAT_MODEL / JUDGE_MODEL 하나만 쓴다.
CHAT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
JUDGE_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# 요청 하나가 Google 응답을 기다리는 최대 시간(초). 넘으면 대체 응답 「…」
LLM_BUDGET_SEC=15

# 1이면 API 응답에 상태·판정 결과가 함께 나옴 (개발할 때만)
DEBUG=1

# 사용량 기록(GET /usage)의 예상 비용 가격표. 비우면 usage.py 의 기본 가격(2026-11)을 씀
# 100만 토큰당 달러 [입력, 출력]. 예: {"gemini-3.5-flash-lite": [0.30, 1.50]}
USAGE_PRICES=
